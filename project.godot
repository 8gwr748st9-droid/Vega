; Engine configuration file.
; Godot 3.6 project – runs on macOS 10.12+ (including High Sierra 10.13.6).

config_version=4

[application]

config/name="Vega"
config/description="Real-time strategy on the desert planet Vega."
run/main_scene="res://scenes/Menu.tscn"

[autoload]

Data="*res://scripts/data.gd"
GameState="*res://scripts/game_state.gd"

[display]

window/size/width=1280
window/size/height=720
window/vsync/use_vsync=true

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

quality/driver/driver_name="GLES2"
quality/driver/fallback_to_gles2=true
batching/options/use_batching=true
environment/default_clear_color=Color( 0.12, 0.09, 0.07, 1 )
